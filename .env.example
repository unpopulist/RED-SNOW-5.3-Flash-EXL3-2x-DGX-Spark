# Copy to .env (next to run.sh) and fill in the <...> values. run.sh passes this file to the engine's deploy
# scripts (REDSNOW_ENV), so every setting of deploy/redsnow/start.sh can go here. The environment wins over the file.

# ---- the engine checkout (on the head) -----------------------------------------------------------------------------
ENGINE_DIR="<path-to-engine-checkout>"          # e.g. /opt/redsnow-engine or a folder under your home

# ---- required: the two nodes ---------------------------------------------------------------------------------------
HEAD_ADDR="<rank0-roce-ip>"                     # rank 0 (this node) on the QSFP/RoCE link
WORKER_ADDR="<rank1-roce-ip>"                   # rank 1 on the same link
WORKER_SSH="<worker-ssh>"                       # user@host, passwordless ssh from the head to the worker

# ---- RoCE devices (DGX Spark defaults; check with `ibdev2netdev`) --------------------------------------------------
# IFACE=enp1s0f0np0
# HCA=rocep1s0f0
# HEAD_GID=                                     # empty: looked up in sysfs from HEAD_ADDR
# WORKER_GID=                                   # empty: looked up in sysfs from WORKER_ADDR

# ---- model folders (absolute paths) --------------------------------------------------------------------------------
# MODEL_RANK0=/var/tmp/models/RED-SNOW-5.3-FLASH-EXL3-SAGE-4.91bpw   # full pack, head
# MODEL_RANK1=/var/tmp/models/redsnow-rank1                          # rank-1 folder, worker
# DRAFTER=/var/tmp/models/GLM-5.3-Flash-DFlash2                      # both nodes, same path; "none": no DFlash2

# ---- serving -------------------------------------------------------------------------------------------------------
# IMAGE=redsnow-tensorfold:<tag>                # default: the tag build gives the engine checkout's HEAD
# SERVED_NAME=RED-SNOW-5.3-FLASH
# PORT=8000
# CONTEXT=327680
# PARALLEL=4
# MEMORY_RESERVE_GIB=14.5
